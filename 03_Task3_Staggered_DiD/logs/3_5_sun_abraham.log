. 
. matrix bb = e(b_iw)

. matrix VV = e(V_iw)

. tempname S

. postfile `S' str12 estimator int event_time double(b se) using "$T3/tables/sa.dta", replace

. forvalues k = 5(-1)2 {
  2.     capture post `S' ("SA") (-`k') (bb[1,"F`k'"]) (sqrt(VV["F`k'","F`k'"]))
  3. }

. post `S' ("SA") (-1) (0) (0)

. forvalues k = 0/5 {
  2.     capture post `S' ("SA") (`k') (bb[1,"L`k'"]) (sqrt(VV["L`k'","L`k'"]))
  3. }

. * overall post-adoption effect: simple average of event years 0-5
. matrix w = J(1, colsof(bb), 0)

. local cn : colnames bb

. local j = 0

. foreach nm of local cn {
  2.     local ++j
  3.     if inlist("`nm'","L0","L1","L2","L3","L4","L5") matrix w[1,`j'] = 1/6
  4. }

. matrix avg  = w*bb'

. matrix vavg = w*VV*w'

. post `S' ("SA_avg_0_5") (99) (avg[1,1]) (sqrt(vavg[1,1]))

. di as res "Sun-Abraham average effect, years 0-5: " %8.4f avg[1,1] "  (SE " %6.4f sqrt(vavg[1,1]) ")"
Sun-Abraham average effect, years 0-5:   0.0236  (SE 0.0888)

. postclose `S'

. 
. use "$T3/tables/sa.dta", clear

. gen lo = b - 1.96*se

. gen hi = b + 1.96*se

. list, noobs sep(0)

