. *==========================================================================
. * 00_config.do
. * Project : Replication of Zhang et al. (2026), "China's solar expansion
. *           policy reduces bird diversity", Science 393, 831.
. * Purpose : One place for paths, globals and package installation.
. *           Every task do-file starts with:  do "<ROOT>/00_config.do"
. * Author  : Sahil (Research Assistant, Johns Hopkins University)
. *==========================================================================
. version 16

. set more off

. set linesize 120

. 
. *---------------------------------------------------------------- paths
. global ROOT "/Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication"

. global ORIG "$ROOT/00_Original_Package"

. global DATA "$ORIG/DATA"

. global T1   "$ROOT/01_Task1_Replication"

. global T2   "$ROOT/02_Task2_Sensitivity"

. global T3   "$ROOT/03_Task3_Staggered_DiD"

. 
. * analysis sample built in Task 1 (used by all tasks)
. global SAMPLE "$T1/data/analysis_sample.dta"

. 
. *---------------------------------------------------------------- model
. * the authors' nine control variables (Table 1, column 3)
. global control     "Temp Wind Pop Duration Carbon Water Green Farm Grass"

. global control_noD "Temp Wind Pop Carbon Water Green Farm Grass"

. 
. *---------------------------------------------------------------- packages
. * installed only if missing
. foreach p in require ftools reghdfe ivreg2 ranktest ivreghdfe estout winsor2 ///
>              psmatch2 binscatter sensemakr drdid csdid did_imputation       ///
>              event_plot avar eventstudyinteract {
  2.     capture which `p'
  3.     if _rc {
  4.         di as txt "installing `p' ..."
  5.         capture noisily ssc install `p', replace
  6.     }
  7. }

. set scheme s2color

. 
end of do-file

. *==========================================================================
. * 3_5_sun_abraham.do
. * PURPOSE : Sun & Abraham (2021) interaction-weighted event study on the
. *           monthly data, never-treated counties as the control cohort.
. *           A third heterogeneity-robust check on the same question.
. * OUTPUT  : tables/3_5_sun_abraham.csv, figures/3_5_event_study_sa.pdf
. *==========================================================================
. use "$T3/data/staggered_monthly.dta", clear

. keep if !missing(g_main)
(20,385 observations deleted)

. 
. * relative-time indicators for every period except the reference (-1)
. summarize rel_year

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
    rel_year |      9,904    2.614398    3.969468         -9          8

. local mn = -r(min)

. local mx = r(max)

. local leads ""

. forvalues k = 2/`mn' {
  2.     gen byte F`k' = (rel_year == -`k')
  3.     local leads "`leads' F`k'"
  4. }

. local lags ""

. forvalues k = 0/`mx' {
  2.     gen byte L`k' = (rel_year == `k')
  3.     local lags "`lags' L`k'"
  4. }

. gen cohort = cond(g_main == 0, ., g_main)
(2,849 missing values generated)

. 
. eventstudyinteract ShannonBD `leads' `lags', cohort(cohort) control_cohort(never_main) ///
>     absorb(county year) vce(cluster county)
(obs=9,904)

