          2  |  -.0173737   .0207346    -0.84   0.402    -.0580139    .0232665
          3  |   .0736119   .0216689     3.40   0.001     .0311406    .1160833
          4  |   .1981946    .020622     9.61   0.000     .1577752    .2386141
          5  |   .2783702   .0203594    13.67   0.000     .2384654     .318275
          6  |   .1622055   .0215908     7.51   0.000     .1198873    .2045238
          7  |   .0392431   .0206092     1.90   0.057    -.0011512    .0796374
          8  |  -.0136875   .0211736    -0.65   0.518     -.055188     .027813
          9  |  -.0477415     .02238    -2.13   0.033    -.0916066   -.0038763
         10  |  -.0165322   .0212537    -0.78   0.437    -.0581898    .0251254
