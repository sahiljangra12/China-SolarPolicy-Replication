        from master                    25,386  
        from using                          0  

    Matched                            21,142  
    -----------------------------------------

. replace in_IC_file = 0 if missing(in_IC_file)
(25,386 real changes made)

. gen lnBN = ln(BN)

. egen pym = group(prov year)

. egen uym = group(urban year)

. 
. *------------------------------------------------ (A) specification grid
. tempname P

. postfile `P' str12 y str6 d str4 fe str8 smp str4 ctrl str6 cl double(b se p N Ncl) ///
>     using "$T7/data/spec_grid.dta", replace
(file /Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication/07_Interactive/data/spec_grid.dta not found)

. local k = 0

. foreach y in ShannonBD Richness Evenness lnBN {
  2.   foreach d in PI Area {
  3.     foreach fe in f1 f2 f3 {
  4.       local abs "county year"
  5.       if "`fe'" == "f2" local abs "county uym"
  6.       if "`fe'" == "f3" local abs "county pym"
  7.       foreach s in all realpsi icfile rural {
  8.         local cond ""
  9.         if "`s'" == "realpsi" local cond "if in_PI_file==1"
 10.         if "`s'" == "icfile"  local cond "if in_IC_file==1"
 11.         if "`s'" == "rural"   local cond "if urban==0"
 12.         foreach c in c0 c1 c2 {
 13.           if "`c'" == "c2" & "`y'" == "lnBN" continue
 14.           local X ""
 15.           if "`c'" == "c1" local X "$control"
 16.           if "`c'" == "c1" & "`y'" == "lnBN" local X "$control_noD"
 17.           if "`c'" == "c2" local X "$control lnBN"
 18.           foreach cl in county city prov {
 19.             local ++k
 20.             capture reghdfe `y' `d' `X' `cond', absorb(`abs') cluster(`cl')
 21.             if _rc == 0 {
 22.               post `P' ("`y'") ("`d'") ("`fe'") ("`s'") ("`c'") ("`cl'") ///
>                 (_b[`d']) (_se[`d']) (2*ttail(e(df_r), abs(_b[`d']/_se[`d']))) (e(N)) (e(N_clust))
 23.             }
 24.             if mod(`k', 50) == 0 di as txt "spec `k' done"
 25.           }
 26.         }
 27.       }
 28.     }
 29.   }
 30. }
spec 50 done
spec 100 done
spec 150 done
spec 200 done
spec 250 done
spec 300 done
spec 350 done
spec 400 done
spec 450 done
spec 500 done
spec 550 done
spec 600 done
spec 650 done
spec 700 done
spec 750 done

. postclose `P'

. 
. *------------------------------------------------ (B) sensitivity inputs
. tempname Q

. postfile `Q' str8 spec double(b se df tY_dur dfY tD_dur dfD N) using "$T7/data/sens_inputs.dta", replace
(file /Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication/07_Interactive/data/sens_inputs.dta not
    found)

. foreach sp in paper urbym realpsi {
  2.     local abs "county year"
  3.     local cond ""
  4.     if "`sp'" == "urbym"   local abs "county uym"
  5.     if "`sp'" == "realpsi" local cond "if in_PI_file==1"
  6.     reghdfe ShannonBD PI $control `cond', absorb(`abs') vce(unadjusted)
  7.     local b = _b[PI]
  8.     local se = _se[PI]
  9.     local df = e(df_r)
 10.     local tY = _b[Duration]/_se[Duration]
 11.     local N = e(N)
 12.     reghdfe PI $control `cond', absorb(`abs') vce(unadjusted)
 13.     post `Q' ("`sp'") (`b') (`se') (`df') (`tY') (`df') (_b[Duration]/_se[Duration]) (e(df_r)) (`N')
 14. }
