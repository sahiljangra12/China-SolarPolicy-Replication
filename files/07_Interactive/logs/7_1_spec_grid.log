* = FE nested within cluster; treated as redundant for DoF computation

. scalar g_hat = _b[Sun_ccpu]

. scalar g_se  = _se[Sun_ccpu]

. tempname R

. postfile `R' str6 cl double(gamma b se N F ghat gse) using "$T7/data/iv_gamma.dta", replace
(file /Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication/07_Interactive/data/iv_gamma.dta not found)

. foreach cl in county city {
  2.     forvalues i = 0/32 {
  3.         local g = -0.006 + `i'*0.00025
  4.         capture drop y_adj
  5.         gen double y_adj = ShannonBD - (`g')*Sun_ccpu
  6.         capture ivreghdfe y_adj (PI = Sun_ccpu) $control, absorb(county year) cluster(`cl') keepsingleton
  7.         if _rc == 0 post `R' ("`cl'") (`g') (_b[PI]) (_se[PI]) (e(N)) (e(widstat)) (g_hat) (g_se)
  8.     }
  9.     capture drop y_adj
 10.     gen double y_adj = ShannonBD - (g_hat)*Sun_ccpu
 11.     capture ivreghdfe y_adj (PI = Sun_ccpu) $control, absorb(county year) cluster(`cl') keepsingleton
 12.     if _rc == 0 post `R' ("`cl'") (g_hat) (_b[PI]) (_se[PI]) (e(N)) (e(widstat)) (g_hat) (g_se)
 13. }

. postclose `R'

. restore

. 
. foreach f in spec_grid sens_inputs iv_gamma {
  2.     use "$T7/data/`f'.dta", clear
  3.     format b se %12.0g
  4.     export delimited using "$T7/data/`f'.csv", replace
  5. }
