. erase "$T2/tables/bd_tmp.dta"

. 
. *--------------------------------------------------------------------------
. * E. Contour plots (adjusted estimate and adjusted t) for each spec
. *--------------------------------------------------------------------------
. forvalues s = 1/2 {
  2.     clear
  3.     local n = 61
  4.     set obs `=`n'*`n''
  5.     gen r2dz = 0.0025*floor((_n-1)/`n')                 // 0 .. 0.15
  6.     gen r2yz = 0.0025*mod(_n-1, `n')
  7.     replace r2dz = 0.0001 if r2dz == 0
  8.     replace r2yz = 0.0001 if r2yz == 0
  9.     gen bias  = se_`s'*sqrt(r2yz*r2dz/(1 - r2dz)*df_`s')
 10.     gen adj   = sign(est_`s')*(abs(est_`s') - bias)
 11.     gen adjse = se_`s'*sqrt((1 - r2yz)/(1 - r2dz)*df_`s'/(df_`s' - 1))
 12.     gen adjt  = adj/adjse
 13.     * benchmark points (Duration k=1,2,3) for spec 1 only
.     if `s' == 1 {
 14.         append using "$T2/tables/bounds_for_plot.dta", keep(benchmark k R2_D_Z R2_Y_Z spec)
 15.         keep if missing(spec) | (strpos(spec,"S1") & (benchmark=="Duration" | strpos(benchmark,"Urban")))
 16.         gen pt_x = R2_D_Z
 17.         gen pt_y = R2_Y_Z
 18.         gen str20 pt_lab = cond(benchmark=="Duration", string(k) + "x Duration", ///
>                             cond(benchmark!="", string(k) + "x urban-YM", ""))
 19.         replace pt_x = . if pt_x > 0.15 | pt_y > 0.15
 20.     }
 21.     else {
 22.         gen pt_x = .
 23.         gen pt_y = .
 24.         gen pt_lab = ""
 25.     }
 26.     local e = string(est_`s', "%6.4f")
 27.     * Contours of the adjusted estimate are closed-form: an adjusted estimate
.     * equal to share f of the original needs bias = (1-f)|est|, i.e.
.     *   R2_YZ = B^2 (1 - R2_DZ) / R2_DZ,   B = (1-f)|est| / (se*sqrt(df))
.     local K = se_`s'*sqrt(df_`s')
 28.     local plots ""
 29.     local txt ""
 30.     foreach f in 0.8 0.6 0.4 0.2 0 {
 31.         local B  = (1-`f')*abs(est_`s')/`K'
 32.         local x0 = max(0.0002, `B'^2/(0.15 + `B'^2))
 33.         local col = cond(`f'==0, "red", "navy")
 34.         local pat = cond(`f'==0, "dash", "solid")
 35.         local wid = cond(`f'==0, "thick", "medium")
 36.         local plots `plots' (function y = (`B')^2*(1-x)/x, range(`x0' 0.15) lcolor(`col') lpattern(`pat') lwidth(`w
> id'))
 37.         local yl = (`B')^2*(0.85)/0.15
 38.         if `yl' <= 0.15 local txt `txt' text(`yl' 0.151 "`=round(100*`f')'% left", place(e) size(vsmall) color(`col
> '))
 39.     }
 40.     twoway `plots' ///
>            (scatter pt_y pt_x, msymbol(D) mcolor(black) mlabel(pt_lab) mlabcolor(black) mlabsize(vsmall)), ///
>         `txt' xscale(range(0 0.17)) ///
>         xtitle("Partial R{superscript:2} of confounder with PSI") ///
>         ytitle("Partial R{superscript:2} of confounder with Shannon") ///
>         title("Adjusted PSI estimate: `nm`s''", size(medium)) ///
>         subtitle("Estimate = `e'. Curves: share of the estimate left after confounding; red = zero", size(vsmall)) ///
>         xlabel(0(0.03)0.15) ylabel(0(0.03)0.15) legend(off)
 41.     graph export "$T2/figures/2_1_contour_estimate_S`s'.pdf", replace
 42.     * t-value: red dashed line where the adjusted t reaches -1.96
.     twoway (contourline adjt r2yz r2dz if !missing(r2dz), ccuts(-1.96) ///
>                 ccolors(red) clwidths(thick) clpatterns(dash)) ///
>            (scatter pt_y pt_x, msymbol(D) mcolor(black) mlabel(pt_lab) mlabcolor(black) mlabsize(vsmall)), ///
>         xtitle("Partial R{superscript:2} of confounder with PSI") ///
