================ 3_4_imputation_bjs ================

. *==========================================================================
. * 00_config.do
. * Project : Replication of Zhang et al. (2026), "China's solar expansion
. *           policy reduces bird diversity", Science 393, 831.
. * Purpose : One place for paths, globals and package installation.
. *           Every task do-file starts with:  do "<ROOT>/00_config.do"
. * Author  : Sahil (Research Assistant, Johns Hopkins University)
. *==========================================================================
. version 16

. set more off

. set linesize 120

. 
. *---------------------------------------------------------------- paths
. global ROOT "/Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication"

. global ORIG "$ROOT/00_Original_Package"

. global DATA "$ORIG/DATA"

. global T1   "$ROOT/01_Task1_Replication"

. global T2   "$ROOT/02_Task2_Sensitivity"

. global T3   "$ROOT/03_Task3_Staggered_DiD"

. 
. * analysis sample built in Task 1 (used by all tasks)
. global SAMPLE "$T1/data/analysis_sample.dta"

. 
. *---------------------------------------------------------------- model
. * the authors' nine control variables (Table 1, column 3)
. global control     "Temp Wind Pop Duration Carbon Water Green Farm Grass"

. global control_noD "Temp Wind Pop Carbon Water Green Farm Grass"

. 
. *---------------------------------------------------------------- packages
. * installed only if missing
. foreach p in require ftools reghdfe ivreg2 ranktest ivreghdfe estout winsor2 ///
>              psmatch2 binscatter sensemakr drdid csdid did_imputation       ///
>              event_plot avar eventstudyinteract {
  2.     capture which `p'
  3.     if _rc {
  4.         di as txt "installing `p' ..."
  5.         capture noisily ssc install `p', replace
  6.     }
  7. }

. set scheme s2color

. 
end of do-file

. *==========================================================================
. * 3_4_imputation_bjs.do
. * PURPOSE : Borusyak, Jaravel & Spiess (2024) imputation estimator on the
. *           MONTHLY data: county and year-month fixed effects are estimated
. *           on untreated observations only, untreated outcomes are imputed
. *           for treated observations, and effects are averaged by event year.
. * WHY     : Uses the authors' own monthly unit and fixed-effect structure,
. *           handles the unbalanced panel, and avoids forbidden comparisons.
. * SPECS   : main sample; paper-style sample
. * OUTPUT  : tables/3_4_bjs.csv, figures/3_4_event_study_bjs_*.pdf
. *==========================================================================
. tempname B

. postfile `B' str40 spec int event_time double(b se) using "$T3/tables/bjs.dta", replace

. 
. foreach s in main paper {
  2.     use "$T3/data/staggered_monthly.dta", clear
  3.     if "`s'" == "main" {
  4.         keep if !missing(g_main)
  5.         gen Ei = cond(g_main == 0, ., g_main)
  6.         local lab "Main sample"
  7.     }
  8.     else {
  9.         gen Ei = cond(g_paper == 0, ., g_paper)
 10.         local lab "Paper-style sample (missing PSI = never)"
 11.     }
 12.     di as res _n "================ BJS: `lab' ================"
 13.     * Imputation needs every county and every year-month to have at least one
.     * UNTREATED observation (their fixed effects are estimated on untreated data
.     * only). Drop the few that never do, iterating until stable.
.     gen byte untreated = missing(Ei) | YEAR < Ei
 14.     local dropped = 1
 15.     while `dropped' > 0 {
 16.         local n0 = _N
 17.         bysort county: egen u_c = max(untreated)
 18.         bysort year:   egen u_t = max(untreated)
 19.         keep if u_c == 1 & u_t == 1
 20.         drop u_c u_t
 21.         local dropped = `n0' - _N
 22.     }
 23. 
.     * overall ATT (all post-adoption observations, equally weighted)
.     capture noisily did_imputation ShannonBD county YEAR Ei, fe(county year) cluster(county) autosample
 24.     if _rc {
 25.         di as err "year-month FE not imputable; falling back to county + year FE"
 26.         local fe "county YEAR"
 27.         did_imputation ShannonBD county YEAR Ei, fe(`fe') cluster(county) autosample
 28.     }
 29.     else local fe "county year"
 30.     post `B' ("`lab'") (99) (_b[tau]) (_se[tau])
 31. 
.     * event study: horizons 0-5, pre-trend coefficients for 5 years
.     did_imputation ShannonBD county YEAR Ei, fe(`fe') cluster(county) ///
>         horizons(0/5) pretrends(5) autosample
 32.     di as res "Fixed effects used: `fe'"
 33.     estimates store bjs_`s'
 34.     forvalues k = 0/5 {
 35.         post `B' ("`lab'") (`k') (_b[tau`k']) (_se[tau`k'])
 36.     }
 37.     forvalues k = 1/5 {
 38.         post `B' ("`lab'") (-`k') (_b[pre`k']) (_se[pre`k'])
 39.     }
 40.     test pre1 pre2 pre3 pre4 pre5
 41.     di as res "Joint pre-trend test p = " %5.3f r(p)
 42. }
