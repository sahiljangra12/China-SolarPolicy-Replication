. *------------------------------------------------ (b) dynamic
. gen ev = rel_year
(2,849 missing values generated)

. replace ev = -5 if ev < -5 & !missing(ev)
(329 real changes made)

. replace ev =  5 if ev >  5 & !missing(ev)
(3,026 real changes made)

. forvalues k = 5(-1)2 {
  2.     gen byte lead`k' = (ev == -`k')
  3. }

. forvalues k = 0/5 {
  2.     gen byte lag`k' = (ev == `k')
  3. }

