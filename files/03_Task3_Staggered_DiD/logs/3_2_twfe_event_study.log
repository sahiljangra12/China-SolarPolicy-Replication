Joint test of pre-trends (leads = 0): p = 0.341

. 
. tempname P

. postfile `P' str12 estimator int event_time double(b se) using "$T3/tables/es_twfe.dta", replace

. forvalues k = 5(-1)2 {
  2.     post `P' ("TWFE") (-`k') (_b[lead`k']) (_se[lead`k'])
  3. }

. post `P' ("TWFE") (-1) (0) (0)

. forvalues k = 0/5 {
  2.     post `P' ("TWFE") (`k') (_b[lag`k']) (_se[lag`k'])
  3. }

. post `P' ("TWFE_static") (99) (static_b) (static_se)

. postclose `P'

. 
. use "$T3/tables/es_twfe.dta", clear

. gen lo = b - 1.96*se

. gen hi = b + 1.96*se

