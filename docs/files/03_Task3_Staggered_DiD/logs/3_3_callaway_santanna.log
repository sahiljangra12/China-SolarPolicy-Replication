. *==========================================================================
. * 00_config.do
. * Project : Replication of Zhang et al. (2026), "China's solar expansion
. *           policy reduces bird diversity", Science 393, 831.
. * Purpose : One place for paths, globals and package installation.
. *           Every task do-file starts with:  do "<ROOT>/00_config.do"
. * Author  : Sahil (Research Assistant, Johns Hopkins University)
. *==========================================================================
. version 16

. set more off

. set linesize 120

. 
. *---------------------------------------------------------------- paths
. global ROOT "/Users/sahiljangra/Desktop/Johns Hopkins/RA/Solar_Birds_Replication"

. global ORIG "$ROOT/00_Original_Package"

. global DATA "$ORIG/DATA"

. global T1   "$ROOT/01_Task1_Replication"

. global T2   "$ROOT/02_Task2_Sensitivity"

. global T3   "$ROOT/03_Task3_Staggered_DiD"

. 
. * analysis sample built in Task 1 (used by all tasks)
. global SAMPLE "$T1/data/analysis_sample.dta"

. 
. *---------------------------------------------------------------- model
. * the authors' nine control variables (Table 1, column 3)
. global control     "Temp Wind Pop Duration Carbon Water Green Farm Grass"

. global control_noD "Temp Wind Pop Carbon Water Green Farm Grass"

. 
. *---------------------------------------------------------------- packages
. * installed only if missing
. foreach p in require ftools reghdfe ivreg2 ranktest ivreghdfe estout winsor2 ///
>              psmatch2 binscatter sensemakr drdid csdid did_imputation       ///
>              event_plot avar eventstudyinteract {
  2.     capture which `p'
  3.     if _rc {
  4.         di as txt "installing `p' ..."
  5.         capture noisily ssc install `p', replace
  6.     }
  7. }

. set scheme s2color

. 
end of do-file

. *==========================================================================
. * 3_3_callaway_santanna.do
. * PURPOSE : Callaway & Sant'Anna (2021) group-time ATT(g,t), aggregated to
. *           an overall ATT and an event study, with NOT-YET-TREATED counties
. *           as controls (never-treated included).
. * DATA    : county-year panel (monthly Shannon averaged within year after
. *           removing month-of-year effects). The panel is UNBALANCED: by default
. *           csdid would balance it by dropping every county not observed in all
. *           10 years (903 of 939 counties). bal(pair) instead balances each 2x2
. *           comparison separately, so every county observed in both years of a
. *           comparison is used.
. * SPECS   : M1 main sample, unconditional parallel trends
. *           M2 main sample, parallel trends conditional on urban
. *           P1 paper-style sample (missing-PSI counties = never treated)
. * OUTPUT  : tables/3_3_cs_att.csv, tables/3_3_cs_event.csv,
. *           figures/3_3_event_study_cs_*.pdf
. *==========================================================================
. *--------------------------------------------------------------------------
. * Helper: aggregate csdid's ATT(g,t) cells. Cells that cannot be estimated
. * (tiny cohorts) must be excluded with -dropmissing-; the option syntax differs
. * across csdid versions, so each variant is tried and the one used is logged.
. * Returns row vectors _B (estimates) and _SE (standard errors).
. *--------------------------------------------------------------------------
. capture program drop cs_agg

. program define cs_agg
  1.     syntax anything(name=type) [, Window(string)]
  2.     local w ""
  3.     if "`window'" != "" local w "window(`window')"
  4.     local used ""
  5.     foreach opt in "post dropmissing" "dropmissing post" "dropmissing" "post" {
  6.         capture noisily estat `type', `w' `opt'
  7.         if _rc == 0 {
  8.             local used "`opt'"
  9.             continue, break
 10.         }
 11.     }
 12.     if "`used'" == "" {
 13.         di as err "estat `type' failed with every option set"
 14.         exit 498
 15.     }
 16.     di as res "estat `type' ran with options: `used'"
 17.     if strpos("`used'", "post") {
 18.         matrix _B = e(b)
 19.         matrix _V = e(V)
 20.     }
 21.     else {
 22.         capture confirm matrix r(b)
 23.         if !_rc {
 24.             matrix _B = r(b)
 25.             matrix _V = r(V)
 26.         }
 27.         else {
 28.             matrix _T = r(table)
 29.             matrix _B = _T[1, 1...]
 30.             matrix _V = diag(_T[2, 1...])
 31.             forvalues i = 1/`=colsof(_V)' {
 32.                 matrix _V[`i',`i'] = _V[`i',`i']^2
 33.             }
 34.         }
 35.     }
 36.     matrix _SE = _B
 37.     forvalues i = 1/`=colsof(_B)' {
 38.         matrix _SE[1,`i'] = sqrt(_V[`i',`i'])
 39.     }
 40.     matrix list _B
 41.     matrix list _SE
 42. end

. 
. tempname A

. postfile `A' str40 spec double(att se N_cy) using "$T3/tables/cs_att.dta", replace

. tempname E

. postfile `E' str40 spec int event_time double(b se) using "$T3/tables/cs_event.dta", replace

. 
. local specs "M1 M2 P1"

. local lab_M1 "Main sample, unconditional"

. local lab_M2 "Main sample, conditional on urban"

. local lab_P1 "Paper-style sample (missing PSI = never)"

. 
. foreach s of local specs {
  2.     use "$T3/data/staggered_countyyear.dta", clear
  3.     if "`s'" == "P1" local gv g_paper
  4.     else {
  5.         local gv g_main
  6.         keep if !missing(g_main)
  7.     }
  8.     local x ""
  9.     if "`s'" == "M2" local x "urban"
 10.     di as res _n "================ CS: `lab_`s'' ================"
 11.     * how unbalanced is the panel? (counties observed in all 10 years)
.     preserve
 12.         bysort county: gen byte nyears = _N
 13.         egen byte tagc = tag(county)
 14.         count if tagc
 15.         local nc = r(N)
 16.         count if tagc & nyears < 10
 17.         di as res "Counties: `nc'; not observed in all 10 years: " r(N)
 18.     restore
 19. 
.     set seed 20261107
 20.     capture noisily csdid shannon_sa `x', ivar(county) time(YEAR) gvar(`gv') notyet bal(pair) rseed(20261107)
 21.     if _rc csdid shannon_sa `x', ivar(county) time(YEAR) gvar(`gv') notyet bal(pair)
 22.     * number of counties and county-years entering the estimation
.     quietly count if e(sample)
 23.     local Ncy = r(N)
 24.     di as res "County-years used: `Ncy'"
 25.     * pre-test of parallel trends (all pre-treatment ATT(g,t) = 0)
.     capture noisily estat pretrend
 26.     estimates store cs_full_`s'
 27. 
.     * overall ATT (simple aggregation)
.     cs_agg simple
 28.     post `A' ("`lab_`s''") (_B[1,1]) (_SE[1,1]) (`Ncy')
 29.     di "Overall ATT = " %8.4f _B[1,1] "  (SE " %6.4f _SE[1,1] ")"
 30. 
.     * event-study aggregation, window -5..+5
.     estimates restore cs_full_`s'
 31.     cs_agg event, window(-5 5)
 32.     local names : colnames _B
 33.     local j = 0
 34.     foreach nm of local names {
 35.         local ++j
 36.         if ustrregexm("`nm'", "^[Tt]m([0-9]+)$") {
 37.             post `E' ("`lab_`s''") (-real(ustrregexs(1))) (_B[1,`j']) (_SE[1,`j'])
 38.         }
 39.         else if ustrregexm("`nm'", "^[Tt]p([0-9]+)$") {
 40.             post `E' ("`lab_`s''") (real(ustrregexs(1))) (_B[1,`j']) (_SE[1,`j'])
 41.         }
 42.         else di "`nm' = " %8.4f _B[1,`j'] "  (SE " %6.4f _SE[1,`j'] ")"
 43.     }
 44. 
.     * cohort-specific ATTs
.     estimates restore cs_full_`s'
 45.     capture noisily cs_agg group
 46. }
