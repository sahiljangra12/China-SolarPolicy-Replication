. *------------------------------------------------ 4. AR confidence set (grid)
. * For each candidate effect b0: regress (Y - b0*PSI) on Z. If b0 is the true
. * effect, Z should have no effect on Y - b0*PSI. Keep every b0 that is NOT
. * rejected at 5%. The kept values form the AR 95% confidence set.
. capture program drop ar_grid

. program define ar_grid
  1.     syntax , CLuster(varname) [FE(string) SUBset(string) LO(real -1.2) HI(real 0.8) STep(real 0.001)]
  2.     if "`fe'" == "" local fe "county year"
  3.     tempvar ry rp rz yb
  4.     quietly reghdfe ShannonBD $control `subset', absorb(`fe') resid(`ry') keepsingleton
  5.     quietly reghdfe PI        $control `subset', absorb(`fe') resid(`rp') keepsingleton
  6.     quietly reghdfe Sun_ccpu  $control `subset', absorb(`fe') resid(`rz') keepsingleton
  7.     quietly gen double `yb' = .
  8.     local prev = 0
  9.     local start = `lo'
 10.     local segs
 11.     local n = round((`hi'-`lo')/`step')
 12.     forvalues i = 0/`n' {
 13.         local b0 = `lo' + `i'*`step'
 14.         quietly replace `yb' = `ry' - `b0'*`rp'
 15.         quietly regress `yb' `rz' if !missing(`ry'), nocons vce(cluster `cluster')
 16.         quietly test `rz'
 17.         local acc = (r(p) > 0.05)
 18.         if `acc' & !`prev' local start = `b0'
 19.         if !`acc' & `prev' {
 20.             local s1 : display %7.4f `start'
 21.             local s2 : display %7.4f `b0'-`step'
 22.             local segs `"`segs' [`s1', `s2']"'
 23.         }
 24.         local prev = `acc'
 25.     }
 26.     if `prev' {
 27.         local s1 : display %7.4f `start'
 28.         local s2 : display %7.4f `hi'
 29.         local segs `"`segs' [`s1', `s2' = grid edge]"'
 30.     }
 31.     di as res `"AR 95% set, cluster(`cluster') fe(`fe') `subset':`segs'"'
 32.     di as txt "   (a segment ending at the grid edge means the set is unbounded on that side)"
 33. end

. 
